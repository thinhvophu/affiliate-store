# Required — base URL for canonical links, sitemap, and OG tags.
# PLACEHOLDER — replace with the real production domain. Production must never ship this value.
# Scheme + host only, no trailing slash (a trailing slash breaks URL composition in lib/seo.ts).
NEXT_PUBLIC_SITE_URL=https://example.com

# Optional — Google Analytics 4 measurement ID.
# Leave empty or omit to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
